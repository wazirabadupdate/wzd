    let allClassifieds = JSON.parse(localStorage.getItem('wzb_classifieds_100')) || [{ id: 301, title: "5 مرلہ مکان برائے فروخت", category: "پراپرٹی و مکانات", price: "60 لاکھ روپے", phone: "03483439886", detail: "نظام آباد میں بہترین لوکیشن پر گھر۔", image: "" }];
    let savedFavorites = JSON.parse(localStorage.getItem('wzb_user_favs')) || [];
    let savedLogo = localStorage.getItem('wzb_site_logo') || "";
    let savedCommercialAd = localStorage.getItem('wzb_commercial_ad') || "";

    let clickCount = 0;
    let clickTimer = null;
    document.getElementById('secretAdminTrigger').addEventListener('click', function() {
      clickCount++;
      if (clickTimer) clearTimeout(clickTimer);
      clickTimer = setTimeout(() => { clickCount = 0; }, 600);

      if (clickCount >= 3) {
        clickCount = 0;
        authAdmin();
      }
    });

    function initCategories() {
      const catUl = document.getElementById('categoryList');
      const pillsBar = document.getElementById('categoryPillsBar');
      const allCatText = currentLang === 'ur' ? 'تمام کیٹگریز' : 'All Categories';

      if(catUl) catUl.innerHTML = `<li class="cat-list-item active" onclick="filterByCategory('all', this)">${allCatText}</li>`;
      if(pillsBar) pillsBar.innerHTML = `<div class="cat-chip active" onclick="filterByCategory('all', this)">${allCatText}</div>`;

      categories.forEach(cat => {
        if(catUl) {
          const li = document.createElement('li');
          li.className = 'cat-list-item'; li.innerText = cat;
          li.onclick = function() { filterByCategory(cat, this); };
          catUl.appendChild(li);
        }
        if(pillsBar) {
          const chip = document.createElement('div');
          chip.className = 'cat-chip'; chip.innerText = cat;
          chip.onclick = function() { filterByCategory(cat, this); };
          pillsBar.appendChild(chip);
        }
      });

      renderDropdownList(categories, 'reqCategoryDropdown', 'reqCategorySearch', 'reqCategory');
      renderDropdownList(categories, 'adminCategoryDropdown', 'adminCategorySearch', 'inputCategory');

      const totalCatCountEl = document.getElementById('totalCatCount');
      if(totalCatCountEl) totalCatCountEl.innerText = categories.length;
      updateFavBadge();
      updateCommercialBannerDisplay();
    }

    function updateCommercialBannerDisplay() {
      const bannerBox = document.getElementById('sponsoredBannerContent');
      if(savedCommercialAd) {
        bannerBox.innerHTML = `<a href="https://wa.me/923483439886?text=السلام علیکم! کمرشل اشتہار کے بارے میں معلومات چاہیے" target="_blank"><img src="${savedCommercialAd}" style="width:100%; max-height:160px; object-fit:cover; border-radius:12px; margin-top:4px;"></a>`;
      } else {
        bannerBox.innerHTML = `<div style="font-weight:800; font-size:0.92rem;"><span data-i18n="adText">📢 اپنا کاروبار یا نوکری کا اشتہار پورٹل پر نمایاں دکھانے کے لیے واٹس ایپ کریں:</span> <u>03483439886</u></div>`;
      }
    }

    function renderDropdownList(list, dropdownId, searchInputId, hiddenInputId) {
      const dropdown = document.getElementById(dropdownId);
      if(!dropdown) return;
      dropdown.innerHTML = '';
      list.forEach(cat => {
        const div = document.createElement('div');
        div.className = 'custom-select-option';
        div.innerText = cat;
        div.onmousedown = function(e) {
          e.preventDefault(); 
          selectDropdownOption(cat, searchInputId, hiddenInputId, dropdownId);
        };
        dropdown.appendChild(div);
      });
    }

    function openDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      if(dropdown) dropdown.style.display = 'block';
    }

    function filterDropdown(searchInputId, dropdownId, hiddenInputId) {
      const input = document.getElementById(searchInputId);
      const filter = input.value.toLowerCase().trim();
      const filtered = categories.filter(c => c.toLowerCase().includes(filter));
      renderDropdownList(filtered, dropdownId, searchInputId, hiddenInputId);
      openDropdown(dropdownId);
    }

    function selectDropdownOption(cat, searchInputId, hiddenInputId, dropdownId) {
      document.getElementById(searchInputId).value = cat;
      document.getElementById(hiddenInputId).value = cat;
      document.getElementById(dropdownId).style.display = 'none';
    }

    document.addEventListener('click', function(e) {
      document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
        const dropdown = wrapper.querySelector('.custom-select-dropdown');
        if(dropdown && !wrapper.contains(e.target)) { dropdown.style.display = 'none'; }
      });
    });

    function updateTicker() {
      const ticker = document.getElementById('tickerContent');
      if (ticker && allNews.length > 0) {
        ticker.innerHTML = allNews.map(n => `🔴 ${n.title}`).join(' &nbsp;&nbsp;&nbsp;&nbsp; | &nbsp;&nbsp;&nbsp;&nbsp; ');
      }
    }

    function toggleFavorite(id) {
      const idx = savedFavorites.indexOf(id);
      if(idx > -1) savedFavorites.splice(idx, 1);
      else savedFavorites.push(id);
      localStorage.setItem('wzb_user_favs', JSON.stringify(savedFavorites));
      updateFavBadge();
      renderContent();
    }

    function updateFavBadge() {
      const badge = document.getElementById('favCountBadge');
      if(badge) badge.innerText = savedFavorites.length;
    }

    function shareToWhatsApp(title, details, phone) {
      const currentUrl = window.location.href.split('#')[0];
      const text = `*${title}*\n${details}\n\n*رابطہ:* ${phone}\n\n🌐 *وزیرآباد سٹی اپڈیٹ پورٹل:* ${currentUrl}`;
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }

    function compressAndPreviewImage(event, type) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const MAX_WIDTH = 500;
          const scale = MAX_WIDTH / img.width;
          canvas.width = MAX_WIDTH;
          canvas.height = img.height * scale;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          const compressed = canvas.toDataURL('image/jpeg', 0.5);

          if(type === 'news') { base64ImageTemp = compressed; document.getElementById('imagePreviewTag').src = compressed; document.getElementById('imagePreviewBox').style.display = 'block'; }
          else if(type === 'dir') { base64DirImageTemp = compressed; document.getElementById('dirImagePreviewTag').src = compressed; document.getElementById('dirImagePreviewBox').style.display = 'block'; }
          else if(type === 'classified') { base64ClassImageTemp = compressed; document.getElementById('classImagePreviewTag').src = compressed; document.getElementById('classImagePreviewBox').style.display = 'block'; }
          else if(type === 'logo') { base64LogoTemp = compressed; document.getElementById('logoPreviewTag').src = compressed; document.getElementById('logoPreviewBox').style.display = 'block'; }
          else if(type === 'commercial') { base64CommercialTemp = compressed; document.getElementById('commercialPreviewTag').src = compressed; document.getElementById('commercialPreviewBox').style.display = 'block'; }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function renderContent() {
      const grid = document.getElementById('mainGrid');
      if(!grid) return;
      grid.innerHTML = '';
      const searchInputEl = document.getElementById('searchInput');
      const q = searchInputEl ? searchInputEl.value.toLowerCase().trim() : '';

      function getAdminCardActions(type, id) {
        if (!isAdminLoggedIn) return '';
        return `
          <div class="admin-card-actions">
            <button class="admin-edit-btn" onclick="editItem('${type}', ${id})"><i class="fa-solid fa-pen-to-square"></i> ایڈٹ</button>
            <button class="admin-del-btn" onclick="deleteItem('${type}', ${id})"><i class="fa-solid fa-trash"></i> حذف</button>
          </div>
        `;
      }

      if (currentMainTab === 'dir') {
        document.getElementById('categoryPillsBar').style.display = 'flex';
        const data = allListings.filter(i => {
          const matchCat = currentCategory === 'all' || (i.category || '') === currentCategory;
          const matchQuery = (i.title || '').toLowerCase().includes(q) || (i.person || '').toLowerCase().includes(q) || (i.address || '').toLowerCase().includes(q) || (i.phone || '').includes(q);
          return matchCat && matchQuery;
        });
        
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `کل انٹریز: ${data.length}` : `Total Entries: ${data.length}`;
        data.forEach(item => {
          const isFav = savedFavorites.includes(item.id);
          let img = item.image ? `<img src="${item.image}" style="width:100%; height:160px; object-fit:cover; border-radius:12px; margin-bottom:12px;">` : '';
          grid.innerHTML += `
            <div class="app-card">
              <div>
                ${img}
                <div class="card-top-row">
                  <div class="card-badge">${item.category}</div>
                  <button class="fav-btn ${isFav ? 'active' : ''}" onclick="toggleFavorite(${item.id})"><i class="fa-${isFav ? 'solid' : 'regular'} fa-heart"></i></button>
                </div>
                <div style="font-size:1.15rem; font-weight:800;">${item.title} ${item.verified ? '<i class="fa-solid fa-circle-check" style="color:var(--accent-emerald);"></i>' : ''}</div>
                <div style="font-size:0.86rem; margin-top:8px; color:var(--text-muted); line-height:1.6;">
                  <div><strong>${currentLang === 'ur' ? 'مالک' : 'Owner'}:</strong> ${item.person || 'N/A'}</div>
                  <div><strong>${currentLang === 'ur' ? 'رابطہ' : 'Phone'}:</strong> ${item.phone}</div>
                  <div><strong>${currentLang === 'ur' ? 'مقام' : 'Address'}:</strong> ${item.address}</div>
                </div>
              </div>
              <div>
                ${getAdminCardActions('dir', item.id)}
                <div class="card-actions-grid">
                  <a href="tel:${item.phone}" class="card-btn btn-call"><i class="fa-solid fa-phone"></i> ${currentLang === 'ur' ? 'کال' : 'Call'}</a>
                  <a href="https://wa.me/${item.phone}?text=السلام%20علیکم!" target="_blank" class="card-btn btn-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                  <button class="card-btn btn-share" onclick="shareToWhatsApp('${item.title}', '${item.address}', '${item.phone}')"><i class="fa-solid fa-share-nodes"></i></button>
                </div>
              </div>
            </div>`;
        });
      } 
      else if (currentMainTab === 'news') {
        document.getElementById('categoryPillsBar').style.display = 'none';
        const data = allNews.filter(n => (n.title || '').toLowerCase().includes(q) || (n.detail || '').toLowerCase().includes(q));
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `کل خبریں: ${data.length}` : `Total News: ${data.length}`;

        data.forEach(item => {
          let img = item.image ? `<img src="${item.image}" style="width:100%; max-height:300px; object-fit:contain; border-radius:12px; margin:12px 0; background:#000;">` : '';
          grid.innerHTML += `
            <div class="app-card" style="grid-column:1/-1;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <div style="font-size:0.8rem; color:var(--text-muted); font-weight:700;"><i class="fa-regular fa-clock"></i> ${item.datetime} | ✍️ ${item.reporter}</div>
                  <button class="card-btn btn-share" style="padding:4px 10px; font-size:0.8rem;" onclick="shareToWhatsApp('${item.title}', '${item.detail.substring(0,60)}...', 'رپورٹر: ${item.reporter}')"><i class="fa-solid fa-share-nodes"></i> شیئر</button>
                </div>
                <h3 style="color:var(--accent-rose); margin:6px 0; font-size:1.25rem; font-weight:800;">${item.title}</h3>
                ${img}
                <p style="font-size:0.95rem; line-height:1.8; color:var(--text-main);">${item.detail}</p>
              </div>
              <div>
                ${getAdminCardActions('news', item.id)}
              </div>
            </div>`;
        });
      }
      else if (currentMainTab === 'transport') {
        document.getElementById('categoryPillsBar').style.display = 'none';
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `وزیرآباد جنکشن ریلوے اسٹیشن (ٹرین ٹائم ٹیبل)` : `Wazirabad Junction Railway Station (Train Schedule)`;

        let trainRows = trainSchedules.map(t => `
          <tr>
            <td><strong>${t.name}</strong></td>
            <td>${t.route}</td>
            <td style="color:var(--accent-emerald); font-weight:800;">${t.arrival}</td>
            <td style="color:var(--accent-rose); font-weight:800;">${t.departure}</td>
          </tr>
        `).join('');

        grid.innerHTML = `
          <div class="app-card" style="grid-column:1/-1;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
              <h3 style="color:var(--accent-cyan); font-weight:900;"><i class="fa-solid fa-train"></i> ٹرین ٹائم ٹیبل</h3>
              <button class="card-btn btn-share" style="padding:4px 10px; font-size:0.8rem;" onclick="shareToWhatsApp('وزیرآباد ٹرین ٹائم ٹیبل', 'تمام اپ اور ڈاؤن ٹرینوں کا شیڈول', 'وزیرآباد ریلوے اسٹیشن')"><i class="fa-solid fa-share-nodes"></i> شیئر</button>
            </div>
            <div style="overflow-x:auto;">
              <table class="transport-table">
                <thead><tr><th>ٹرین کا نام</th><th>روٹ</th><th>آمد</th><th>روانگی</th></tr></thead>
                <tbody>${trainRows}</tbody>
              </table>
            </div>
          </div>`;
      }
      else if (currentMainTab === 'jobs') {
        document.getElementById('categoryPillsBar').style.display = 'none';
        const data = allJobs.filter(j => (j.title || '').toLowerCase().includes(q) || (j.company || '').toLowerCase().includes(q));
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `دستیاب نوکریاں: ${data.length}` : `Available Jobs: ${data.length}`;

        data.forEach(item => {
          grid.innerHTML += `
            <div class="app-card" style="border-top: 4px solid var(--accent-emerald);">
              <div>
                <div style="font-size:1.15rem; font-weight:800; color:var(--accent-emerald);">💼 ${item.title}</div>
                <div style="font-size:0.92rem; font-weight:700; margin-top:4px;">🏢 ${item.company}</div>
                <div style="background:rgba(16,185,129,0.12); color:var(--accent-emerald); padding:4px 12px; border-radius:10px; display:inline-block; font-size:0.85rem; font-weight:800; margin:10px 0;">💰 تنخواہ: ${item.salary || 'مفاہمت کے مطابق'}</div>
                <div style="font-size:0.86rem; color:var(--text-muted);"><strong>📍 مقام:</strong> ${item.location}</div>
                <p style="font-size:0.88rem; margin-top:8px;">${item.detail || ''}</p>
              </div>
              <div>
                ${getAdminCardActions('job', item.id)}
                <div class="card-actions-grid">
                  <a href="tel:${item.phone}" class="card-btn btn-call"><i class="fa-solid fa-phone"></i> کال</a>
                  <a href="https://wa.me/${item.phone}?text=السلام%20علیکم!" target="_blank" class="card-btn btn-wa"><i class="fa-brands fa-whatsapp"></i> Apply</a>
                  <button class="card-btn btn-share" onclick="shareToWhatsApp('${item.title}', 'Company: ${item.company}', '${item.phone}')"><i class="fa-solid fa-share-nodes"></i></button>
                </div>
              </div>
            </div>`;
        });
      }
      else if (currentMainTab === 'classifieds') {
        document.getElementById('categoryPillsBar').style.display = 'none';
        const data = allClassifieds.filter(c => (c.title || '').toLowerCase().includes(q));
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `اشتہارات: ${data.length}` : `Classifieds: ${data.length}`;

        data.forEach(item => {
          let img = item.image ? `<img src="${item.image}" style="width:100%; height:160px; object-fit:cover; border-radius:12px; margin-bottom:12px;">` : '';
          grid.innerHTML += `
            <div class="app-card" style="border-top: 4px solid var(--accent-amber);">
              <div>
                ${img}
                <div style="font-size:1.15rem; font-weight:800; color:var(--accent-amber);">🏡 ${item.title}</div>
                <span class="card-badge">${item.category}</span>
                <div style="font-size:1.1rem; font-weight:800; color:var(--accent-rose); margin:8px 0;">🏷 طلب: ${item.price}</div>
                <p style="font-size:0.88rem; color:var(--text-muted);">${item.detail || ''}</p>
              </div>
              <div>
                ${getAdminCardActions('classified', item.id)}
                <div class="card-actions-grid">
                  <a href="tel:${item.phone}" class="card-btn btn-call"><i class="fa-solid fa-phone"></i> کال</a>
                  <a href="https://wa.me/${item.phone}?text=السلام%20علیکم!" target="_blank" class="card-btn btn-wa"><i class="fa-brands fa-whatsapp"></i> رابطہ</a>
                  <button class="card-btn btn-share" onclick="shareToWhatsApp('${item.title}', 'Price: ${item.price}', '${item.phone}')"><i class="fa-solid fa-share-nodes"></i></button>
                </div>
              </div>
            </div>`;
        });
      }
      else if (currentMainTab === 'favs') {
        document.getElementById('categoryPillsBar').style.display = 'none';
        const favListings = allListings.filter(i => savedFavorites.includes(i.id));
        document.getElementById('resultsCount').innerText = currentLang === 'ur' ? `محفوظ کردہ آئٹمز: ${favListings.length}` : `Saved Items: ${favListings.length}`;

        if(favListings.length === 0) {
          grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--text-muted); font-weight:700;">آپ نے ابھی تک کوئی انٹری پسندیدہ میں محفوظ نہیں کی۔</div>`;
          return;
        }

        favListings.forEach(item => {
          grid.innerHTML += `
            <div class="app-card">
              <div>
                <div class="card-top-row">
                  <div class="card-badge">${item.category}</div>
                  <button class="fav-btn active" onclick="toggleFavorite(${item.id})"><i class="fa-solid fa-heart"></i></button>
                </div>
                <div style="font-size:1.15rem; font-weight:800;">${item.title}</div>
                <div style="font-size:0.86rem; color:var(--text-muted); margin-top:6px;">${item.phone} | ${item.address}</div>
              </div>
              <div>
                ${getAdminCardActions('dir', item.id)}
                <div class="card-actions-grid">
                  <a href="tel:${item.phone}" class="card-btn btn-call"><i class="fa-solid fa-phone"></i> کال</a>
                  <a href="https://wa.me/${item.phone}?text=السلام%20علیکم!" target="_blank" class="card-btn btn-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                  <button class="card-btn btn-share" onclick="shareToWhatsApp('${item.title}', '${item.address}', '${item.phone}')"><i class="fa-solid fa-share-nodes"></i></button>
                </div>
              </div>
            </div>`;
        });
      }
    }

    function switchMainTab(tab) {
      currentMainTab = tab;
      document.querySelectorAll('.app-tab-item, .bottom-tab-item').forEach(el => el.classList.remove('active'));
      
      if(tab === 'dir') { document.getElementById('tabDirBtn').classList.add('active'); document.getElementById('bTabDir').classList.add('active'); }
      else if(tab === 'news') { document.getElementById('tabNewsBtn').classList.add('active'); document.getElementById('bTabNews').classList.add('active'); }
      else if(tab === 'transport') { document.getElementById('tabTransportBtn').classList.add('active'); document.getElementById('bTabTrans').classList.add('active'); }
      else if(tab === 'jobs') { document.getElementById('tabJobsBtn').classList.add('active'); document.getElementById('bTabJobs').classList.add('active'); }
      else if(tab === 'classifieds') { document.getElementById('tabClassifiedsBtn').classList.add('active'); }
      else if(tab === 'favs') { document.getElementById('tabFavsBtn').classList.add('active'); }

      renderContent();
    }

    function filterContent() { renderContent(); }
    
    function filterByCategory(cat, element) {
      currentCategory = cat;
      document.querySelectorAll('.cat-list-item, .cat-chip').forEach(el => el.classList.remove('active'));
      if(element) element.classList.add('active');
      if(currentMainTab !== 'dir') switchMainTab('dir');
      else renderContent();
    }

    function authAdmin() {
      if(isAdminLoggedIn) { 
        document.getElementById('adminModal').style.display = 'flex'; 
        initCategories();
        return; 
      }
      const pin = prompt("🔐 ایڈمن پاسورڈ درج کریں (Admin PIN):");
      if (pin === ADMIN_PIN) {
        isAdminLoggedIn = true;
        document.getElementById('adminModal').style.display = 'flex';
        initCategories();
        renderContent();
      } else if (pin !== null) { alert("❌ غلط پاسورڈ!"); }
    }

    function closeAdminModal() { document.getElementById('adminModal').style.display = 'none'; }

    function showAdminForm(formType) {
      document.getElementById('addListingForm').style.display = 'none';
      document.getElementById('addNewsForm').style.display = 'none';
      document.getElementById('addJobForm').style.display = 'none';
      document.getElementById('addClassifiedForm').style.display = 'none';
      document.getElementById('addAdForm').style.display = 'none';

      if(formType === 'dir') { resetDirForm(); document.getElementById('addListingForm').style.display = 'block'; initCategories(); }
      else if(formType === 'news') { resetNewsForm(); document.getElementById('addNewsForm').style.display = 'block'; }
      else if(formType === 'jobs') { resetJobForm(); document.getElementById('addJobForm').style.display = 'block'; }
      else if(formType === 'classifieds') { resetClassForm(); document.getElementById('addClassifiedForm').style.display = 'block'; }
      else if(formType === 'ad') { document.getElementById('addAdForm').style.display = 'block'; }
    }

    function editItem(type, id) {
      isAdminLoggedIn = true;
      document.getElementById('adminModal').style.display = 'flex';
      if(type === 'dir') {
        showAdminForm('dir');
        editDirectory(id);
      } else if(type === 'news') {
        showAdminForm('news');
        editNews(id);
      } else if(type === 'job') {
        showAdminForm('jobs');
        editJob(id);
      } else if(type === 'classified') {
        showAdminForm('classifieds');
        editClassified(id);
      }
    }

    function deleteItem(type, id) {
      if(type === 'dir') deleteDirectory(id);
      else if(type === 'news') deleteNews(id);
      else if(type === 'job') deleteJob(id);
      else if(type === 'classified') deleteClassified(id);
    }

    /* Directory Edit & Submit */
    function resetDirForm() {
      document.getElementById('editDirId').value = '';
      document.getElementById('inputTitle').value = '';
      document.getElementById('inputPerson').value = '';
      document.getElementById('adminCategorySearch').value = '';
      document.getElementById('inputCategory').value = '';
      document.getElementById('inputPhone').value = '';
      document.getElementById('inputAddress').value = '';
      document.getElementById('inputVerified').checked = false;
      base64DirImageTemp = '';
      document.getElementById('dirImagePreviewBox').style.display = 'none';
      document.getElementById('dirFormHeading').innerText = "1. نیا کاروبار شامل کریں:";
      document.getElementById('dirSubmitBtn').innerText = "محفوظ کریں";
    }

    function editDirectory(id) {
      const item = allListings.find(i => i.id === id);
      if(!item) return;
      document.getElementById('editDirId').value = item.id;
      document.getElementById('inputTitle').value = item.title;
      document.getElementById('inputPerson').value = item.person || '';
      document.getElementById('adminCategorySearch').value = item.category;
      document.getElementById('inputCategory').value = item.category;
      document.getElementById('inputPhone').value = item.phone;
      document.getElementById('inputAddress').value = item.address;
      document.getElementById('inputVerified').checked = item.verified;
      base64DirImageTemp = item.image || '';
      if(item.image) {
        document.getElementById('dirImagePreviewTag').src = item.image;
        document.getElementById('dirImagePreviewBox').style.display = 'block';
      } else {
        document.getElementById('dirImagePreviewBox').style.display = 'none';
      }
      document.getElementById('dirFormHeading').innerText = "1. کاروبار کی معلومات میں ترمیم کریں:";
      document.getElementById('dirSubmitBtn').innerText = "اپڈیٹ کریں";
    }

    function deleteDirectory(id) {
      if(confirm('کیا آپ اس انٹری کو حذف کرنا چاہتے ہیں؟')) {
        allListings = allListings.filter(i => i.id !== id);
        localStorage.setItem('wzb_dir_100', JSON.stringify(allListings));
        renderContent();
      }
    }

    function handleDirectorySubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('editDirId').value;
      const cat = document.getElementById('inputCategory').value || document.getElementById('adminCategorySearch').value;

      if(editId) {
        const idx = allListings.findIndex(i => i.id == editId);
        if(idx > -1) {
          allListings[idx].title = document.getElementById('inputTitle').value;
          allListings[idx].person = document.getElementById('inputPerson').value;
          allListings[idx].category = cat;
          allListings[idx].phone = document.getElementById('inputPhone').value;
          allListings[idx].address = document.getElementById('inputAddress').value;
          allListings[idx].verified = document.getElementById('inputVerified').checked;
          if(base64DirImageTemp) allListings[idx].image = base64DirImageTemp;
        }
        alert('کاروباری ریکارڈ کامیابی سے اپڈیٹ کر دیا گیا ہے!');
      } else {
        const newItem = {
          id: Date.now(),
          title: document.getElementById('inputTitle').value,
          person: document.getElementById('inputPerson').value,
          category: cat,
          phone: document.getElementById('inputPhone').value,
          address: document.getElementById('inputAddress').value,
          verified: document.getElementById('inputVerified').checked,
          image: base64DirImageTemp
        };
        allListings.unshift(newItem);
        alert('نیا کاروبار کامیابی سے شامل کر دیا گیا ہے!');
      }

      localStorage.setItem('wzb_dir_100', JSON.stringify(allListings));
      resetDirForm();
      closeAdminModal();
      renderContent();
    }

    /* News Edit & Submit */
    function resetNewsForm() {
      document.getElementById('editNewsId').value = '';
      document.getElementById('newsTitle').value = '';
      document.getElementById('newsDetail').value = '';
      document.getElementById('newsReporter').value = '';
      base64ImageTemp = '';
      document.getElementById('imagePreviewBox').style.display = 'none';
      document.getElementById('newsFormHeading').innerText = "2. تازہ خبر شائع کریں:";
      document.getElementById('newsSubmitBtn').innerText = "خبر شائع کریں";
    }

    function editNews(id) {
      const item = allNews.find(n => n.id === id);
      if(!item) return;
      document.getElementById('editNewsId').value = item.id;
      document.getElementById('newsTitle').value = item.title;
      document.getElementById('newsDetail').value = item.detail;
      document.getElementById('newsReporter').value = item.reporter;
      base64ImageTemp = item.image || '';
      if(item.image) {
        document.getElementById('imagePreviewTag').src = item.image;
        document.getElementById('imagePreviewBox').style.display = 'block';
      } else {
        document.getElementById('imagePreviewBox').style.display = 'none';
      }
      document.getElementById('newsFormHeading').innerText = "2. خبر میں ترمیم کریں:";
      document.getElementById('newsSubmitBtn').innerText = "خبر اپڈیٹ کریں";
    }

    function deleteNews(id) {
      if(confirm('کیا آپ اس خبر کو حذف کرنا چاہتے ہیں؟')) {
        allNews = allNews.filter(n => n.id !== id);
        localStorage.setItem('wzb_news_100', JSON.stringify(allNews));
        updateTicker();
        renderContent();
      }
    }

    function handleNewsSubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('editNewsId').value;
      if(editId) {
        const idx = allNews.findIndex(n => n.id == editId);
        if(idx > -1) {
          allNews[idx].title = document.getElementById('newsTitle').value;
          allNews[idx].detail = document.getElementById('newsDetail').value;
          allNews[idx].reporter = document.getElementById('newsReporter').value || 'سٹی رپورٹر';
          if(base64ImageTemp) allNews[idx].image = base64ImageTemp;
        }
        alert('خبر کامیابی سے اپڈیٹ ہو گئی!');
      } else {
        const newNews = {
          id: Date.now(),
          title: document.getElementById('newsTitle').value,
          detail: document.getElementById('newsDetail').value,
          reporter: document.getElementById('newsReporter').value || 'سٹی رپورٹر',
          datetime: new Date().toLocaleDateString('ur-PK'),
          image: base64ImageTemp
        };
        allNews.unshift(newNews);
        alert('خبر کامیابی سے شائع ہو گئی!');
      }
      localStorage.setItem('wzb_news_100', JSON.stringify(allNews));
      updateTicker();
      resetNewsForm();
      closeAdminModal();
      switchMainTab('news');
    }

    /* Job Edit & Submit */
    function resetJobForm() {
      document.getElementById('editJobId').value = '';
      document.getElementById('jobTitle').value = '';
      document.getElementById('jobCompany').value = '';
      document.getElementById('jobSalary').value = '';
      document.getElementById('jobPhone').value = '';
      document.getElementById('jobLocation').value = '';
      document.getElementById('jobDetail').value = '';
      document.getElementById('jobFormHeading').innerText = "3. نئی نوکری پوسٹ کریں:";
      document.getElementById('jobSubmitBtn').innerText = "نوکری لگائیں";
    }

    function editJob(id) {
      const item = allJobs.find(j => j.id === id);
      if(!item) return;
      document.getElementById('editJobId').value = item.id;
      document.getElementById('jobTitle').value = item.title;
      document.getElementById('jobCompany').value = item.company;
      document.getElementById('jobSalary').value = item.salary || '';
      document.getElementById('jobPhone').value = item.phone;
      document.getElementById('jobLocation').value = item.location;
      document.getElementById('jobDetail').value = item.detail || '';
      document.getElementById('jobFormHeading').innerText = "3. نوکری کی معلومات میں ترمیم کریں:";
      document.getElementById('jobSubmitBtn').innerText = "نوکری اپڈیٹ کریں";
    }

    function deleteJob(id) {
      if(confirm('کیا آپ اس نوکری کو حذف کرنا چاہتے ہیں؟')) {
        allJobs = allJobs.filter(j => j.id !== id);
        localStorage.setItem('wzb_jobs_100', JSON.stringify(allJobs));
        renderContent();
      }
    }

    function handleJobSubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('editJobId').value;
      if(editId) {
        const idx = allJobs.findIndex(j => j.id == editId);
        if(idx > -1) {
          allJobs[idx].title = document.getElementById('jobTitle').value;
          allJobs[idx].company = document.getElementById('jobCompany').value;
          allJobs[idx].salary = document.getElementById('jobSalary').value;
          allJobs[idx].phone = document.getElementById('jobPhone').value;
          allJobs[idx].location = document.getElementById('jobLocation').value;
          allJobs[idx].detail = document.getElementById('jobDetail').value;
        }
        alert('نوکری کامیابی سے اپڈیٹ ہو گئی!');
      } else {
        const newJob = {
          id: Date.now(),
          title: document.getElementById('jobTitle').value,
          company: document.getElementById('jobCompany').value,
          salary: document.getElementById('jobSalary').value,
          phone: document.getElementById('jobPhone').value,
          location: document.getElementById('jobLocation').value,
          detail: document.getElementById('jobDetail').value
        };
        allJobs.unshift(newJob);
        alert('نوکری کامیابی سے پوسٹ ہو گئی!');
      }
      localStorage.setItem('wzb_jobs_100', JSON.stringify(allJobs));
      resetJobForm();
      closeAdminModal();
      switchMainTab('jobs');
    }

    /* Classifieds Edit & Submit (यहाँ ठीक कर दिया گیا ہے) */
    function resetClassForm() {
      document.getElementById('editClassId').value = '';
      document.getElementById('classTitle').value = '';
      document.getElementById('classPrice').value = '';
      document.getElementById('classPhone').value = '';
      document.getElementById('classDetail').value = '';
      base64ClassImageTemp = '';
      document.getElementById('classImagePreviewBox').style.display = 'none';
      document.getElementById('classFormHeading').innerText = "4. خرید و فروخت / پراپرٹی:";
      document.getElementById('classSubmitBtn').innerText = "اشتہار شائع کریں";
    }

    function editClassified(id) {
      const item = allClassifieds.find(c => c.id === id);
      if(!item) return;
      document.getElementById('editClassId').value = item.id;
      document.getElementById('classTitle').value = item.title;
      document.getElementById('classCat').value = item.category;
      document.getElementById('classPrice').value = item.price;
      document.getElementById('classPhone').value = item.phone;
      document.getElementById('classDetail').value = item.detail || '';
      base64ClassImageTemp = item.image || '';
      if(item.image) {
        document.getElementById('classImagePreviewTag').src = item.image;
        document.getElementById('classImagePreviewBox').style.display = 'block';
      } else {
        document.getElementById('classImagePreviewBox').style.display = 'none';
      }
      document.getElementById('classFormHeading').innerText = "4. اشتہار میں ترمیم کریں:";
      document.getElementById('classSubmitBtn').innerText = "اشتہار اپڈیٹ کریں";
    }

    function deleteClassified(id) {
      if(confirm('کیا آپ اس اشتہار کو حذف کرنا چاہتے ہیں؟')) {
        allClassifieds = allClassifieds.filter(c => c.id !== id);
        localStorage.setItem('wzb_classifieds_100', JSON.stringify(allClassifieds));
        renderContent();
      }
    }

    function handleClassifiedSubmit(e) {
      e.preventDefault();
      const editId = document.getElementById('editClassId').value;
      if(editId) {
        const idx = allClassifieds.findIndex(c => c.id == editId);
        if(idx > -1) {
          allClassifieds[idx].title = document.getElementById('classTitle').value;
          allClassifieds[idx].category = document.getElementById('classCat').value;
          allClassifieds[idx].price = document.getElementById('classPrice').value;
          allClassifieds[idx].phone = document.getElementById('classPhone').value; // صحیح نام (allClassifieds) یہاں درست کر دیا گیا ہے
          allClassifieds[idx].detail = document.getElementById('classDetail').value;
          if(base64ClassImageTemp) allClassifieds[idx].image = base64ClassImageTemp;
        }
        alert('اشتہار کامیابی سے اپڈیٹ ہو گیا!');
      } else {
        const newClass = {
          id: Date.now(),
          title: document.getElementById('classTitle').value,
          category: document.getElementById('classCat').value,
          price: document.getElementById('classPrice').value,
          phone: document.getElementById('classPhone').value,
          detail: document.getElementById('classDetail').value,
          image: base64ClassImageTemp
        };
        allClassifieds.unshift(newClass);
        alert('اشتہار کامیابی سے شائع ہو گیا!');
      }
      localStorage.setItem('wzb_classifieds_100', JSON.stringify(allClassifieds));
      resetClassForm();
      closeAdminModal();
      switchMainTab('classifieds');
    }

    /* Logo & Commercial Ad Submit Handler */
    function handleAdSubmit(e) {
      e.preventDefault();
      if(base64LogoTemp) {
        localStorage.setItem('wzb_site_logo', base64LogoTemp);
        document.getElementById('siteLogoImg').src = base64LogoTemp;
      }
      if(base64CommercialTemp) {
        localStorage.setItem('wzb_commercial_ad', base64CommercialTemp);
        savedCommercialAd = base64CommercialTemp;
        updateCommercialBannerDisplay();
      }
      alert('کمرشل بینر اور لوگو کامیابی سے پوسٹ / محفوظ ہو گئے!'); 
      closeAdminModal();
    }

    function sendCustomerRequest(e) {
      e.preventDefault();
      const name = document.getElementById('reqName').value;
      const phone = document.getElementById('reqPhone').value;
      const category = document.getElementById('reqCategory').value || document.getElementById('reqCategorySearch').value;
      const message = document.getElementById('reqMessage').value;

      const whatsappNum = "923483439886";
      const currentUrl = window.location.href.split('#')[0];
      const text = `*ڈائریکٹری اندراج کی درخواست* 📝\n\n*کاروبار کا نام:* ${name}\n*رابطہ نمبر:* ${phone}\n*کیٹگری:* ${category}\n*تفصیل:* ${message}\n\n🌐 *پورٹل لنک:* ${currentUrl}`;
      
      window.open(`https://wa.me/${whatsappNum}?text=${encodeURIComponent(text)}`, '_blank');
      e.target.reset();
      document.getElementById('reqCategory').value = '';
    }

    function sendFeedback(e) {
      e.preventDefault();
      const text = document.getElementById('feedbackText').value;
      const currentUrl = window.location.href.split('#')[0];
      window.open(`https://wa.me/923483439886?text=${encodeURIComponent('*فیڈ بیک:* ' + text + '\n\n🌐 *پورٹل لنک:* ' + currentUrl)}`, '_blank');
    }

    function toggleTheme() { document.body.classList.toggle('dark-mode'); }

    window.onload = () => {
      if(savedLogo) document.getElementById('siteLogoImg').src = savedLogo;
      if(savedCommercialAd) updateCommercialBannerDisplay();
      updateLiveClock();
      fetchWazirabadWeather();
      trackVisitorStats();
      initCategories();
      updateTicker();
      renderContent();
    };
  </script>
</body>
</html>
