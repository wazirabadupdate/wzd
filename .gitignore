        tabDir: "🏢 ڈائریکٹری",
        tabNews: "📰 تاز ترین خبریں",
        tabTrans: "🚆 ٹرین ٹائم ٹیبل",
        tabJobs: "💼 نوکریاں (Jobs)",
        tabClass: "🏡 خرید و فروخت",
        tabFavs: "❤️ پسندیدہ",
        marketRatesTitle: "وزیرآباد ڈیلی نرخ:",
        rate1: "🐔 مرغی (زندہ):",
        rate2: "🥚 انڈے (درجن):",
        rate3: "🌾 آٹا (20kg):",
        rate4: "🔥 LPG گیس:",
        rate5: "👑 سونا (24k):",
        sponsoredTag: "اسپانسرڈ اشتہار",
        adText: "📢 اپنا کاروبار یا نوکری کا اشتہار پورٹل پر نمایاں دکھانے کے لیے واٹس ایپ کریں:",
        sidebarTitle: "شہر کی تمام کیٹگریز",
