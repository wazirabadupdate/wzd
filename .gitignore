    function toggleLanguage() {
      currentLang = currentLang === 'ur' ? 'en' : 'ur';
      const htmlRoot = document.getElementById('htmlRoot');
      const langBtnText = document.getElementById('langBtnText');

      if (currentLang === 'en') {
        htmlRoot.setAttribute('lang', 'en');
        htmlRoot.setAttribute('dir', 'ltr');
        langBtnText.innerText = "اردو";
      } else {
        htmlRoot.setAttribute('lang', 'ur');
        htmlRoot.setAttribute('dir', 'rtl');
        langBtnText.innerText = "English";
      }

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[currentLang][key]) {
          el.innerHTML = translations[currentLang][key];
        }
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (translations[currentLang][key]) {
          el.placeholder = translations[currentLang][key];
        }
      });
    }

    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferredPrompt = e; });
    function installPWA() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((res) => { if(res.outcome === 'accepted') alert('Portal App is installing!'); deferredPrompt = null; });
      } else { alert('Click "Add to Home Screen" from your browser menu.'); }
    }

    function startVoiceSearch() {
      if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Voice search is not supported by your browser.');
        return;
      }
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      const recognition = new SpeechRecognition();
      recognition.lang = currentLang === 'ur' ? 'ur-PK' : 'en-US';
      recognition.interimResults = false;

      const micBtn = document.getElementById('voiceSearchBtn');
      micBtn.classList.add('listening');
      recognition.start();

      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        document.getElementById('searchInput').value = transcript;
        filterContent();
        micBtn.classList.remove('listening');
      };
      recognition.onerror = () => { micBtn.classList.remove('listening'); };
      recognition.onend = () => { micBtn.classList.remove('listening'); };
    }

    function updateLiveClock() {
      const topClock = document.getElementById('liveClockDisplay');
      const now = new Date();
      const daysUrdu = ['اتوار', 'پیر', 'منگل', 'بدھ', 'جمعرات', 'جمعہ', 'ہفتہ'];
      const monthsUrdu = ['جنوری', 'فروری', 'مارچ', 'اپریل', 'مئی', 'جون', 'جولائی', 'اگست', 'ستمبر', 'اکتوبر', 'نومبر', 'دسمبر'];
      const daysEng = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const monthsEng = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      let dateStr = currentLang === 'ur' ? `${daysUrdu[now.getDay()]}، ${now.getDate()} ${monthsUrdu[now.getMonth()]}` : `${daysEng[now.getDay()]}, ${monthsEng[now.getMonth()]} ${now.getDate()}`;
      let hours = now.getHours();
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const ampm = hours >= 12 ? (currentLang === 'ur' ? 'شام' : 'PM') : (currentLang === 'ur' ? 'صبح' : 'AM');
      hours = hours % 12 || 12;

      if(topClock) topClock.innerHTML = `<i class="fa-solid fa-clock"></i> ${dateStr} | ${hours}:${minutes} ${ampm}`;
    }
    setInterval(updateLiveClock, 1000);

    async function fetchWazirabadWeather() {
      try {
        const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=32.4431&longitude=74.1221&current_weather=true');
        const data = await res.json();
        const cityLabel = currentLang === 'ur' ? 'وزیرآباد' : 'Wazirabad';
        document.getElementById('weatherDisplay').innerHTML = `<i class="fa-solid fa-cloud-sun"></i> ${cityLabel}: ${Math.round(data.current_weather.temperature)}°C 🌤️️`;
      } catch (e) {}
    }

    function trackVisitorStats() {
      let todayCount = parseInt(localStorage.getItem('wzb_today_visits') || '45');
      let totalCount = parseInt(localStorage.getItem('wzb_total_visits') || '560');
      document.getElementById('todayVisitsCount').innerText = todayCount + 1;
      document.getElementById('totalVisitsCount').innerText = totalCount + 1;
      localStorage.setItem('wzb_today_visits', todayCount + 1);
      localStorage.setItem('wzb_total_visits', totalCount + 1);
    }

